# Gunakan IPv4 komputer untuk Expo Go pada perangkat fisik.
# Laravel `artisan serve` menggunakan HTTP secara default.
EXPO_PUBLIC_API_URL=http://192.168.0.109:8000/api
EXPO_PUBLIC_AUTH_CLIENT_TYPE=mobile
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.0.109

# Opsional: diperlukan untuk push notification PWA. Nilai EXPO_PUBLIC_* akan
# terlihat di bundle web dan harus berasal dari Firebase Web App yang sama.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
